# ---------------------------------------------------------------------------
# TP6 · Ejemplo del .env de UN entorno del VPS (sólo nombres y placeholders).
#
# En el VPS hay un archivo por entorno, NUNCA en el repo:
#   /opt/ingsoft3-tp6/qa/.env     y     /opt/ingsoft3-tp6/prod/.env
#   dueño tp6deploy:tp6deploy, chmod 600
# Lo lee deploy.sh vía "docker compose --env-file .env" (ver deploy/compose.yml,
# que falla con ${VAR:?} si falta alguna).
#
# QA y PROD deben tener secretos DISTINTOS. Para generar cada uno:
#   openssl rand -hex 24
# ---------------------------------------------------------------------------

# Puerto en 127.0.0.1 donde publica el frontend; nginx del host hace proxy acá.
# 3610 en QA, 3620 en PROD (tiene que coincidir con el vhost).
FRONT_PORT=3610

# Contraseña de root del contenedor mysql:8 de este entorno.
MYSQL_ROOT_PASSWORD=cambiar-por-openssl-rand-hex-24

# Contraseña del usuario de la app en MySQL (la usan mysql y el backend).
DB_PASSWORD=cambiar-por-openssl-rand-hex-24

# Secreto para firmar los JWT del backend.
JWT_SECRET=cambiar-por-openssl-rand-hex-24
